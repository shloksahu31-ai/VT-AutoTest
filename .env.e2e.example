# E2E environment — copy this file to `.env.e2e` and fill in real values.
# `.env.e2e` is gitignored and must never be committed.

# Target environment (UAT demo by default).
E2E_BASE_URL=https://uat-demo.vacaturetovenaar.nl

# Demo account used by both the auth warm-up (global-setup) and the in-page
# self-healing login (`ensureSession` in every card spec).
E2E_USERNAME=your-test-user@example.com
E2E_PASSWORD=your-test-password

# Base32 TOTP secret for the account's 2FA (spaces are ignored).
E2E_TOTP_SECRET=JBSWY3DPEHPK3PXP
