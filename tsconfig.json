{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["e2e/**/*", "opencode/**/*", "playwright.config.ts"],
  "exclude": ["node_modules", "e2e/results", "opencode/test-results*"]
}
